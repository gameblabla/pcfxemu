WASM_CC ?= clang
WASM_LD ?= wasm-ld
PORT ?= 8008
CHD ?= YES
VIDEO_FORMAT ?= RGBA8888
OUT_DIR := web
OUT_WASM := $(OUT_DIR)/pcfx_wasm_core.wasm
BUILD_DIR := build-wasm

ifeq ($(VIDEO_FORMAT),RGB565)
WASM_VIDEO_DEFINES := -DWANT_16BPP -DFRONTEND_SUPPORTS_RGB565
else ifeq ($(VIDEO_FORMAT),ARGB8888)
WASM_VIDEO_DEFINES := -DWANT_32BPP
else
WASM_VIDEO_DEFINES := -DWANT_32BPP -DFRONTEND_SUPPORTS_RGBA8888
endif


WASM_CFLAGS := --target=wasm32-unknown-unknown -O2 -g0 -fno-common -std=gnu11 -D__STDC_HOSTED__=0 \
  -Iwasm/libc/include -Ipcfx-common/include -Ishell/headers -Ishell/video/headless -Ishell/audio -Ishell/scalers \
  -Ishell/input/headless -Ishell/input -Ishell/menu -Ishell/emu -Iheadless -Imednafen -Imednafen/pcfx \
  -Imednafen/sound -Imednafen/video -Imednafen/hw_cpu -Imednafen/hw_sound -I. \
  -Ideps/libchdr/include -Ideps/lzma-19.00/include -Ideps/zlib-1.2.11 \
  -DLSB_FIRST -DNDEBUG -DWANT_STEREO_SOUND $(WASM_VIDEO_DEFINES) -DWANT_PCFX_EMU \
  -DSIZEOF_DOUBLE=8 -DMEDNAFEN_VERSION=\"0.9.36.5\" -DPACKAGE=\"mednafen\" -DMEDNAFEN_VERSION_NUMERIC=9365 \
  -DMPC_FIXED_POINT -DSTDC_HEADERS -D__STDC_LIMIT_MACROS -D_LOW_ACCURACY_ -DPACKAGE_VERSION=\"1.3.3\" \
  -DHAVE_LROUND -DHAVE_STDINT_H -DHAVE_STDLIB_H -DHAVE_SYS_PARAM_H -DPCFX_HEADLESS -DHAVE_HUC6273 \
  -DPCFX_V810_ACCURATE_ONLY=1 -DHAVE_CHD -D_7ZIP_ST -DPCFX_WASM -DPCFX_ADPCM_COMPAT_OPTIONS \
  -Wno-builtin-macro-redefined -Wno-deprecated-non-prototype

WASM_LDFLAGS := --no-entry --export-memory --initial-memory=134217728 --max-memory=1073741824 --allow-undefined
WASM_EXPORTS := \
  --export=pcfx_wasm_vfs_clear --export=pcfx_wasm_vfs_add_file --export=pcfx_wasm_vfs_add_host_file --export=pcfx_wasm_vfs_count \
  --export=pcfx_wasm_version --export=pcfx_wasm_malloc --export=pcfx_wasm_reset_heap --export=pcfx_wasm_heap_used --export=pcfx_wasm_init \
  --export=pcfx_wasm_set_system_mode --export=pcfx_wasm_set_3d_enabled --export=pcfx_wasm_get_3d_enabled \
  --export=pcfx_wasm_set_bios_patches --export=pcfx_wasm_get_bios_patches --export=pcfx_wasm_set_cd_speed --export=pcfx_wasm_get_cd_speed \
  --export=pcfx_wasm_set_adpcm_compat --export=pcfx_wasm_get_adpcm_buggy_codec_mode --export=pcfx_wasm_get_adpcm_suppress_reset_clicks --export=pcfx_wasm_get_adpcm_effective_buggy_codec \
  --export=pcfx_wasm_set_browser_smooth --export=pcfx_wasm_set_controller_type --export=pcfx_wasm_get_controller_type --export=pcfx_wasm_load_bios --export=pcfx_wasm_set_media_path \
  --export=pcfx_wasm_set_media --export=pcfx_wasm_start --export=pcfx_wasm_swap_disc --export=pcfx_wasm_soft_reset --export=pcfx_wasm_frame --export=pcfx_wasm_frame2 \
  --export=pcfx_wasm_get_framebuffer --export=pcfx_wasm_get_width --export=pcfx_wasm_get_height \
  --export=pcfx_wasm_get_pitch_pixels --export=pcfx_wasm_get_pixel_format --export=pcfx_wasm_get_bytes_per_pixel --export=pcfx_wasm_get_status --export=pcfx_wasm_get_error \
  --export=pcfx_wasm_get_frame_count --export=pcfx_wasm_get_media_kind --export=pcfx_wasm_get_audio_rate \
  --export=pcfx_wasm_get_audio_ptr --export=pcfx_wasm_get_audio_frames --export=pcfx_wasm_audio_consume \
  --export=pcfx_wasm_save_state \
  --export=pcfx_wasm_get_save_ptr --export=pcfx_wasm_get_save_size --export=pcfx_wasm_load_state

CORE_SRCS := $(shell find headless shell/emu shell/video/headless shell/audio/headless shell/input/headless mednafen deps/libchdr/src deps/lzma-19.00/src deps/zlib-1.2.11 wasm/libc/src -name '*.c' | grep -v headless/pcfx_headless_cli.c | grep -v deps/zlib-1.2.11/example.c | grep -v deps/zlib-1.2.11/minigzip.c | grep -v 'deps/zlib-1.2.11/gz') wasm/pcfx_wasm_core.c
OBJS := $(patsubst %.c,$(BUILD_DIR)/%.o,$(CORE_SRCS))

.PHONY: build all clean serve test
all: build
build: $(OUT_WASM)

$(OUT_WASM): $(OBJS) | $(OUT_DIR)
	$(WASM_LD) $(WASM_LDFLAGS) $(WASM_EXPORTS) -o $@ $(OBJS)

$(BUILD_DIR)/%.o: %.c
	@mkdir -p $(dir $@)
	$(WASM_CC) $(WASM_CFLAGS) -c $< -o $@

$(OUT_DIR):
	mkdir -p $(OUT_DIR)

test: build
	node tools/wasm_smoke_test.mjs $(OUT_WASM)

serve: build
	@echo "Serving $(OUT_DIR) at http://127.0.0.1:$(PORT)/"
	python3 -m http.server $(PORT) --directory $(OUT_DIR)

clean:
	rm -rf $(BUILD_DIR) $(OUT_WASM)
